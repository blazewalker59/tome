# ──────────────────────────────────────────────────────────────────────────────
# Database — Cloudflare D1
# ──────────────────────────────────────────────────────────────────────────────
# There is no connection string. The database is a Worker BINDING (`env.DB`),
# declared in wrangler.jsonc, and the app reaches it that way in dev and in
# production alike. `bun run dev` runs inside workerd via
# @cloudflare/vite-plugin, so it gets a real local D1 — seed it once with:
#
#   bun run db:migrate:local
#
# The variables below are only needed by the Node-side scripts in scripts/,
# which run outside the Worker and so must use D1's HTTP API instead of a
# binding (see scripts/_db.ts). They are NOT needed to run the app.
#
#   Account ID:  Cloudflare dashboard → Workers & Pages → Account details
#   Database ID: `bunx wrangler d1 list`, or wrangler.jsonc
#   Token:       My Profile → API Tokens → Create → D1:Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=9974d01e-6ed2-4369-a81c-fbf34d195f0a
CLOUDFLARE_D1_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# Better Auth
# ──────────────────────────────────────────────────────────────────────────────
# Generate once with: openssl rand -base64 32
# Rotate by changing this value — existing sessions will be invalidated.
BETTER_AUTH_SECRET=

# The canonical origin Better Auth uses to build callback URLs and validate
# CSRF. In dev this is usually http://localhost:3000; in production it must
# match the deployed origin exactly (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Google OAuth (server-only)
# ──────────────────────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client.
# Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google    (dev)
#   https://<your-prod-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Hardcover GraphQL API (server-only)
# ──────────────────────────────────────────────────────────────────────────────
# Get one at https://hardcover.app/account/api. Treat as a full-account
# credential — never ship it in a client bundle. Tokens rotate every Jan 1.
HARDCOVER_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# Admin allowlist (server-only)
# ──────────────────────────────────────────────────────────────────────────────
# Comma-separated list of emails allowed to hit admin-only routes like
# /admin/ingest. Leave blank to disable admin routes entirely (fail-closed).
# Matched case-insensitively against the session user's email.
ADMIN_EMAILS=
