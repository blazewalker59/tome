{
  "name": "tome",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "prettier --check . && eslint .",
    "ci": "bun run check && bun run typecheck && bun run test:run && bun run test:integration && bun run build",
    "ship": "bun run ci && wrangler deploy dist/server/index.js --config wrangler.jsonc --env production",
    "cf:tail": "wrangler tail tome",
    "cf:secret": "wrangler secret put",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tome-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tome-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-editor-packs": "tsx scripts/seed-editor-packs.ts",
    "db:rebucket": "tsx scripts/rebucket.ts",
    "db:delete-booker-pack": "tsx scripts/delete-booker-pack.ts",
    "db:reset-my-collection": "tsx scripts/reset-my-collection.ts",
    "favicons": "tsx scripts/favicons.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "^1.6.5",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.545.0",
    "motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@cloudflare/vitest-pool-workers": "^0.21.1",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "^0.3.4",
    "@tanstack/react-query": "^5.99.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^28.1.0",
    "msw": "^2.13.4",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.6.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.8",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4",
    "wrangler": "^4.120.1"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
